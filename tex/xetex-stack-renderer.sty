\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage
  {xetex-stack-renderer}
  {2026-10-05}
  {0.8}
  {Unicode-driven stack rendering framework for XeTeX}

\RequirePackage{xsr-core}
\RequirePackage{l3keys2e}

\ExplSyntaxOn

\keys_define:nn { xsr }
  {
    mode .choice:,
    mode / auto .code:n = { \tl_gset:Nn \g_xsr_mode_tl { auto } },
    mode / shell .code:n = { \tl_gset:Nn \g_xsr_mode_tl { shell } },
    mode / preprocess .code:n =
      { \tl_gset:Nn \g_xsr_mode_tl { preprocess } },
    mode / stub .code:n = { \tl_gset:Nn \g_xsr_mode_tl { stub } },
    mode .initial:n = auto,
    renderer-command .tl_gset:N = \g_xsr_renderer_command_tl,
    cache-dir .tl_gset:N = \g_xsr_cache_dir_tl,
    trace .bool_gset:N = \g_xsr_trace_bool,
    trace .initial:n = true,
  }

\ProcessKeysOptions { xsr }

% Standalone usage enables the replaceable active detector. Hosts may instead
% load xsr-core plus a backend and call \xsr_dispatch_run:nn directly.
\RequirePackage{xsr-detector-active}
\RequirePackage{xsr-egyptian}
\RequirePackage{xsr-khitan}

\ExplSyntaxOff

\endinput
