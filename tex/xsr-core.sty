\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage
  {xsr-core}
  {2026-08-28}
  {0.1.0}
  {Core registry and run dispatcher for xetex-stack-renderer}

\RequirePackage{expl3}

\ExplSyntaxOn

\msg_new:nnn { xsr } { xetex-required }
  { xetex-stack-renderer~requires~XeTeX/XeLaTeX. }
\msg_new:nnn { xsr } { duplicate-script }
  { Script~'#1'~has~already~been~registered. }
\msg_new:nnn { xsr } { missing-handler }
  { No~handler~is~registered~for~script~'#1'. }
\msg_new:nnn { xsr } { external-failed }
  { External~renderer~did~not~produce~'#1';~using~the~TeX~stub. }
\msg_new:nnn { xsr } { preprocess-missing }
  { Preprocessed~response~'#1'~is~missing;~using~the~TeX~stub. }
\msg_new:nnn { xsr } { shell-disabled }
  { Unrestricted~shell~escape~is~disabled;~using~the~TeX~stub. }

\sys_if_engine_xetex:F { \msg_fatal:nn { xsr } { xetex-required } }

% Frontend configuration.  The public package owns the option syntax; the
% core only consumes these values.
\tl_new:N \g_xsr_mode_tl
\tl_new:N \g_xsr_renderer_command_tl
\tl_new:N \g_xsr_cache_dir_tl
\bool_new:N \g_xsr_trace_bool
\tl_gset:Nn \g_xsr_mode_tl { auto }
\tl_gset:Nn \g_xsr_renderer_command_tl { python~-m~xsr.renderer }
\tl_gset:Nn \g_xsr_cache_dir_tl { .xsr-cache }
\bool_gset_true:N \g_xsr_trace_bool

% Script/range registry.
\prop_new:N \g_xsr_script_class_prop
\prop_new:N \g_xsr_script_handler_prop
\seq_new:N \g_xsr_script_seq
\seq_new:N \l_xsr_range_parts_seq
\int_new:N \l_xsr_range_start_int
\int_new:N \l_xsr_range_end_int
\tl_new:N \l_xsr_class_tl
\tl_new:N \l_xsr_active_script_tl
\tl_new:N \l_xsr_active_run_tl

\group_begin:
  \char_set_catcode_active:n { 0 }
  \cs_gset_protected:Npn \xsr_peek_active:TF
    { \peek_catcode:NTF ^^@ }
\group_end:

\cs_new_protected:Npn \xsr_define_active:nn #1#2
  {
    \cs_gset_protected:cpx { g_xsr_active_#2: }
      {
        \exp_not:N \xsr_active_char:nn
          {#1}
          { \char_generate:nn {#2} { 12 } }
      }
    \char_gset_active_eq:nc {#2} { g_xsr_active_#2: }
  }

\cs_new_protected:Npn \xsr_assign_range:nnn #1#2#3
  {
    \seq_set_split:Nnn \l_xsr_range_parts_seq { - } {#2}
    \int_set:Nn \l_xsr_range_start_int
      { "\seq_item:Nn \l_xsr_range_parts_seq { 1 } }
    \int_set:Nn \l_xsr_range_end_int
      { "\seq_item:Nn \l_xsr_range_parts_seq { 2 } }
    \int_step_inline:nnn
      { \l_xsr_range_start_int }
      { \l_xsr_range_end_int }
      {
        \XeTeXcharclass ##1 = #1\scan_stop:
        \char_set_catcode_active:n {##1}
        \exp_args:Nee \xsr_define_active:nn
          {#3}
          {##1}
      }
  }

% #1 script name; #2 comma-separated inclusive hexadecimal ranges;
% #3 backend handler control-sequence name (without a leading backslash).
\cs_new_protected:Npn \xsr_script_register:nnn #1#2#3
  {
    \prop_if_in:NnTF \g_xsr_script_class_prop {#1}
      { \msg_error:nnn { xsr } { duplicate-script } {#1} }
      {
        \exp_args:Nc \newXeTeXintercharclass { g_xsr_#1_class }
        \tl_set:Nx \l_xsr_class_tl
          { \int_to_arabic:n { \use:c { g_xsr_#1_class } } }
        \prop_gput:NnV \g_xsr_script_class_prop {#1} \l_xsr_class_tl
        \prop_gput:Nnn \g_xsr_script_handler_prop {#1} {#3}
        \clist_map_inline:nn {#2}
          { \xsr_assign_range:nnn { \l_xsr_class_tl } {##1} {#1} }
        \seq_gput_right:Nn \g_xsr_script_seq {#1}
      }
  }

% Run detection.  Registered Unicode characters are active collectors, but
% dispatch happens only once at the end of an adjacent active-character span
% (or when the registered script changes).
\cs_new_protected:Npn \xsr_active_flush:
  {
    \tl_if_empty:NF \l_xsr_active_run_tl
      {
        \exp_args:NVV \xsr_dispatch:nn
          \l_xsr_active_script_tl \l_xsr_active_run_tl
        \tl_clear:N \l_xsr_active_script_tl
        \tl_clear:N \l_xsr_active_run_tl
      }
  }

\cs_new_protected:Npn \xsr_active_char:nn #1#2
  {
    \tl_if_empty:NTF \l_xsr_active_run_tl
      { \tl_set:Nn \l_xsr_active_script_tl {#1} }
      {
        \str_if_eq:VnF \l_xsr_active_script_tl {#1}
          {
            \xsr_active_flush:
            \tl_set:Nn \l_xsr_active_script_tl {#1}
          }
      }
    \tl_put_right:Nn \l_xsr_active_run_tl {#2}
    \xsr_peek_active:TF
      { }
      { \xsr_active_flush: }
  }

\cs_new_protected:Npn \xsr_dispatch:nn #1#2
  {
    \prop_get:NnNTF \g_xsr_script_handler_prop {#1} \l_tmpa_tl
      {
        \bool_if:NT \g_xsr_trace_bool
          {
            \iow_term:x
              { XSR-DISPATCH~script=#1~codepoints=\int_eval:n { \tl_count:n {#2} } }
          }
        \use:c { \l_tmpa_tl } {#1} {#2}
      }
      { \msg_error:nnn { xsr } { missing-handler } {#1} }
  }

% External renderer and cache bridge.
\int_new:N \g_xsr_run_int
\iow_new:N \g_xsr_request_iow
\seq_new:N \l_xsr_codepoints_seq
\tl_new:N \l_xsr_request_file_tl
\tl_new:N \l_xsr_response_file_tl

\cs_new_protected:Npn \xsr_write_request:nn #1#2
  {
    \seq_clear:N \l_xsr_codepoints_seq
    \tl_map_inline:nn {#2}
      {
        \seq_put_right:Nx \l_xsr_codepoints_seq
          { \int_to_Hex:n { `##1 } }
      }
    \iow_open:NV \g_xsr_request_iow \l_xsr_request_file_tl
    \iow_now:Nn \g_xsr_request_iow { XSR1 }
    \iow_now:Nx \g_xsr_request_iow { script=#1 }
    \iow_now:Nx \g_xsr_request_iow
      { codepoints=\seq_use:Nn \l_xsr_codepoints_seq { ~ } }
    \iow_close:N \g_xsr_request_iow
  }

\cs_new_protected:Npn \xsr_input_response:
  { \exp_args:NV \file_input:n \l_xsr_response_file_tl }

\cs_new_protected:Npn \xsr_tex_stub:nn #1#2
  {
    \xsr_backend_result:nnn
      {#1}
      { \int_eval:n { \tl_count:n {#2} } }
      { tex-fallback }
  }

\cs_new_protected:Npn \xsr_shell_render:nn #1#2
  {
    \sys_if_shell_unrestricted:TF
      {
        \xsr_write_request:nn {#1} {#2}
        \sys_shell_now:x
          {
            \g_xsr_renderer_command_tl \c_space_tl render
            \c_space_tl --backend \c_space_tl #1
            \c_space_tl --input \c_space_tl "\l_xsr_request_file_tl"
            \c_space_tl --output \c_space_tl "\l_xsr_response_file_tl"
            \c_space_tl --cache-dir \c_space_tl "\g_xsr_cache_dir_tl"
          }
        \file_if_exist:VTF \l_xsr_response_file_tl
          { \xsr_input_response: }
          {
            \msg_warning:nnx { xsr } { external-failed }
              { \l_xsr_response_file_tl }
            \xsr_tex_stub:nn {#1} {#2}
          }
      }
      {
        \msg_warning:nn { xsr } { shell-disabled }
        \xsr_tex_stub:nn {#1} {#2}
      }
  }

\cs_new_protected:Npn \xsr_preprocessed_or_stub:nn #1#2
  {
    \file_if_exist:VTF \l_xsr_response_file_tl
      { \xsr_input_response: }
      {
        \msg_warning:nnx { xsr } { preprocess-missing }
          { \l_xsr_response_file_tl }
        \xsr_tex_stub:nn {#1} {#2}
      }
  }

% Backend-facing interface.  A backend receives (script name, complete run)
% and normally delegates here; a future in-process backend may choose not to.
\cs_new_protected:Npn \xsr_external_render:nn #1#2
  {
    \int_gincr:N \g_xsr_run_int
    \tl_set:Nx \l_xsr_request_file_tl
      { \c_sys_jobname_str .xsr-\int_use:N \g_xsr_run_int .req }
    \tl_set:Nx \l_xsr_response_file_tl
      { \c_sys_jobname_str .xsr-\int_use:N \g_xsr_run_int .tex }
    \str_case:VnF \g_xsr_mode_tl
      {
        { shell }     { \xsr_shell_render:nn {#1} {#2} }
        { preprocess }{ \xsr_preprocessed_or_stub:nn {#1} {#2} }
        { stub }      { \xsr_tex_stub:nn {#1} {#2} }
        { auto }
          {
            \file_if_exist:VTF \l_xsr_response_file_tl
              { \xsr_input_response: }
              { \xsr_shell_render:nn {#1} {#2} }
          }
      }
      { \xsr_tex_stub:nn {#1} {#2} }
  }

% Stable TeX response command emitted by Python backends.
\cs_new_protected:Npn \xsr_backend_result:nnn #1#2#3
  {
    \iow_term:x { XSR-BACKEND~script=#1~codepoints=#2~digest=#3 }
    \mbox{\fbox{\ttfamily XSR~#1~stub:~#2~codepoints}}
  }
\NewDocumentCommand \xsrBackendResult { m m m }
  { \xsr_backend_result:nnn {#1} {#2} {#3} }

\ExplSyntaxOff

\endinput
